# 大模型 API 密钥配置
# 支持 OpenAI 官方、DeepSeek、阿里通义千问、Kimi 或各种中转 API（兼容 OpenAI 格式即可）
OPENAI_API_KEY=your_api_key_here

# 接口地址（如果是官方写 https://api.openai.com/v1 ，如果是 DeepSeek 写 https://api.deepseek.com/v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称，例如: gpt-4o-mini, deepseek-chat, qwen-plus 等
MODEL_NAME=gpt-4o-mini
